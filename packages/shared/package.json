{
  "name": "@kata/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod contracts (schemas, enums, error codes, money helpers) consumed as TypeScript source by the API and web apps.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
