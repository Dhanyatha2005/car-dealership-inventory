# Committed on purpose: local docker credentials and a throwaway JWT secret only.
# Loaded by `npm run test:integration` via dotenv-cli. Variables already set in the
# environment (for example TEST_DATABASE_URL in a parallel worktree, or DATABASE_URL in CI)
# take precedence over this file.

NODE_ENV=test
PORT=0
DATABASE_URL=postgresql://kata:kata@localhost:5433/kata_test
JWT_SECRET=test-only-throwaway-secret-not-used-anywhere-real-000
JWT_EXPIRES_IN=1h
BCRYPT_COST=4
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_MAX=10000
TRUST_PROXY=0
LOG_LEVEL=silent
