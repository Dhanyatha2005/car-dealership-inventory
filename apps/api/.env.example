# Copy to apps/api/.env for local development: cp .env.example .env
# Values below match docker-compose.yml (host port 5433). Never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres (docker compose). DIRECT_DATABASE_URL is optional and used for migrations
# (in production it is Neon's direct, non-pooled URL).
DATABASE_URL=postgresql://kata:kata@localhost:5433/kata_dev
# DIRECT_DATABASE_URL=

# Auth. JWT_SECRET must be at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_COST=12

# Comma-separated list of allowed browser origins (required in production).
CORS_ORIGINS=http://localhost:5173

# Requests per 15 minutes on /api/auth/register and /api/auth/login.
AUTH_RATE_LIMIT_MAX=20

# Set to 1 only behind a reverse proxy (Render).
TRUST_PROXY=0
LOG_LEVEL=info

# Seed (npm run db:seed): initial admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_NAME=Admin
